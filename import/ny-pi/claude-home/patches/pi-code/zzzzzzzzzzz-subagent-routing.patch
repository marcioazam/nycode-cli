diff -ruN a/subagent/routing/apply.ts b/subagent/routing/apply.ts
--- a/subagent/routing/apply.ts	1969-12-31 21:00:00.000000000 -0300
+++ b/subagent/routing/apply.ts	2026-11-14 01:00:21.137067810 -0300
@@ -0,0 +1,88 @@
+/**
+ * Applies the saved routing policy to one spawn (docs/subagent-routing-2026-11-13.md, AC5-AC7): the routed
+ * model and effort replace the agent's pin, a spawn's `tools`/`skills` only narrow the agent's own, the child
+ * runs without the skill catalog, and the child's env carries the parent ceiling and its `agents:` allowlist.
+ * With no policy the agent is returned untouched. A spawn is never refused for a policy problem.
+ */
+import type { AgentConfig } from '../agents.ts'
+import { maxSubagentDepth, subagentDepth } from '../nesting/index.ts'
+import { ALLOWED_AGENTS_ENV, childAllowedAgents, narrowList, narrowSkills } from './capabilities.ts'
+import { loadPolicy } from './policy.ts'
+import { type CatalogModel, routeSpawn } from './route.ts'
+
+export const PARENT_MODEL_ENV = 'PI_CODE_SUBAGENT_PARENT_MODEL'
+export const PARENT_EFFORT_ENV = 'PI_CODE_SUBAGENT_PARENT_EFFORT'
+/** Read by skills.ts: a child with this set receives no skill paths from resources_discover. */
+export const NO_SKILLS_ENV = 'PI_CODE_SUBAGENT_NO_SKILLS'
+
+type Env = Record<string, string | undefined>
+
+/** What the orchestrator may ask for, per spawn. */
+export interface SpawnRequest {
+  model?: string
+  effort?: string
+  tools?: string[]
+  skills?: string[]
+}
+
+export interface RoutingSession {
+  catalog: CatalogModel[]
+  /** The session's own model key and thinking level (the parent of a depth-1 spawn). */
+  model?: string
+  effort?: string
+}
+
+export interface ResolvedSpawn {
+  agent: AgentConfig
+  env: Record<string, string>
+  args: string[]
+  /** `route: ...` line for the result text; absent when nothing was routed. */
+  note?: string
+}
+
+let session: RoutingSession = { catalog: [] }
+export function setRoutingSession(next: RoutingSession): void {
+  session = next
+}
+
+export function routingNote(route: { model: string; effort: string; source: string; reason: string }, ignored: string[]): string {
+  return `route: ${route.model} · ${route.effort} (${route.source}: ${route.reason}${ignored.length ? `; ignored ${ignored.join('; ')}` : ''})`
+}
+
+export function resolveSpawn(agent: AgentConfig, request: SpawnRequest | undefined, brief: string, env: Env = process.env): ResolvedSpawn {
+  const base: ResolvedSpawn = { agent, env: { [ALLOWED_AGENTS_ENV]: childAllowedAgents(agent, env) }, args: [] }
+  if (base.env[ALLOWED_AGENTS_ENV] === '') delete base.env[ALLOWED_AGENTS_ENV]
+  try {
+    const policy = loadPolicy(env)
+    if (!policy) return base
+    const degree = subagentDepth(env) + 1
+    const route = routeSpawn({
+      policy,
+      catalog: session.catalog,
+      parent: { model: env[PARENT_MODEL_ENV] ?? session.model, effort: env[PARENT_EFFORT_ENV] ?? session.effort },
+      degree,
+      agent: { name: agent.name, tools: agent.tools, pin: agent.model ?? agent.modelAlias },
+      brief,
+      request,
+    })
+    const tools = narrowList(agent.tools, request?.tools)
+    const skills = narrowSkills(agent.skills, request?.skills)
+    const atCeiling = degree >= maxSubagentDepth(env)
+    const routed: AgentConfig = {
+      ...agent,
+      ...(route ? { model: route.model, modelAlias: undefined, effort: route.effort } : {}),
+      ...(tools.value ? { tools: tools.value } : {}),
+      ...(skills.value ? { skills: skills.value } : {}),
+      ...(atCeiling ? { disallowedTools: [...(agent.disallowedTools ?? []), 'subagent'] } : {}),
+    }
+    const ignored = [...(tools.ignored.length ? [`tools ${tools.ignored.join(',')}`] : []), ...(skills.ignored.length ? [`skills ${skills.ignored.join(',')}`] : [])]
+    return {
+      agent: routed,
+      env: { ...base.env, ...(route ? { [PARENT_MODEL_ENV]: route.model, [PARENT_EFFORT_ENV]: route.effort } : {}), [NO_SKILLS_ENV]: '1' },
+      args: ['--no-skills'],
+      note: route ? routingNote(route, ignored) : `route: no allowed model available, agent pin kept${ignored.length ? `; ignored ${ignored.join('; ')}` : ''}`,
+    }
+  } catch (error) {
+    return { ...base, note: `route: skipped (${(error as Error).message})` }
+  }
+}
diff -ruN a/subagent/routing/capabilities.ts b/subagent/routing/capabilities.ts
--- a/subagent/routing/capabilities.ts	1969-12-31 21:00:00.000000000 -0300
+++ b/subagent/routing/capabilities.ts	2026-11-14 01:00:21.137049870 -0300
@@ -0,0 +1,70 @@
+/**
+ * Per-spawn capability narrowing (docs/subagent-routing-2026-11-13.md, AC6/AC7): the agent's frontmatter stays
+ * the source of tools and skills; a spawn may only narrow them, never widen. Plus the `agents:` allowlist a
+ * child carries to its own spawns, and the depth ceiling that removes the `subagent` tool.
+ */
+import type { AgentConfig } from '../agents.ts'
+
+export const ALLOWED_AGENTS_ENV = 'PI_CODE_SUBAGENT_ALLOWED_AGENTS'
+
+const fold = (name: string): string => name.toLowerCase().replaceAll('-', '_')
+const strings = (value: unknown): string[] | undefined => (Array.isArray(value) ? value.filter((v): v is string => typeof v === 'string' && v.trim() !== '').map((v) => v.trim()) : undefined)
+
+/** Does the agent's grant `entry` (an exact name or a `prefix*` pattern) cover the requested name? */
+const covers = (entry: string, name: string): boolean => (entry.endsWith('*') ? fold(name).startsWith(fold(entry.slice(0, -1))) : fold(entry) === fold(name))
+
+export interface Narrowed {
+  value: string[] | undefined
+  ignored: string[]
+}
+
+/** Narrow `own` (undefined = unrestricted) by `requested`. A request that leaves nothing is ignored whole. */
+export function narrowList(own: string[] | undefined, requestedRaw: unknown): Narrowed {
+  const requested = strings(requestedRaw)
+  if (!requested || requested.length === 0) return { value: own, ignored: [] }
+  if (own === undefined) return { value: requested, ignored: [] }
+  // An exact grant is emitted in the agent's own spelling; a `prefix*` grant yields the narrower requested name.
+  const kept = new Set<string>()
+  const ignored: string[] = []
+  for (const name of requested) {
+    const entry = own.find((e) => covers(e, name))
+    if (entry === undefined) ignored.push(name)
+    else kept.add(entry.endsWith('*') ? name : entry)
+  }
+  if (kept.size === 0) return { value: own, ignored: requested }
+  return { value: [...kept], ignored }
+}
+
+/** Skills a child may preload: only the agent's own, narrowed by the request (it can never add one). */
+export function narrowSkills(own: string[] | undefined, requestedRaw: unknown): Narrowed {
+  const requested = strings(requestedRaw)
+  if (!requested || requested.length === 0) return { value: own, ignored: [] }
+  const owned = own ?? []
+  const kept = requested.filter((name) => owned.includes(name))
+  return { value: kept.length > 0 ? kept : own, ignored: requested.filter((name) => !kept.includes(name)) }
+}
+
+/** The `agents:` allowlist a child inherits (JSON array) = the agent's own ∩ the one this process inherited; empty string = unrestricted. */
+export function childAllowedAgents(agent: Pick<AgentConfig, 'agents'>, env: Record<string, string | undefined> = process.env): string {
+  const inherited = allowedAgents(env)
+  const own = agent.agents
+  const effective = own && inherited ? own.filter((name) => inherited.includes(name)) : (own ?? inherited)
+  return effective ? JSON.stringify(effective) : ''
+}
+
+/** The names this session may spawn, from the env its parent set; undefined = all. A malformed value restricts nothing. */
+export function allowedAgents(env: Record<string, string | undefined> = process.env): string[] | undefined {
+  const raw = env[ALLOWED_AGENTS_ENV]
+  if (!raw) return undefined
+  try {
+    return strings(JSON.parse(raw))
+  } catch {
+    return undefined
+  }
+}
+
+/** Keep only the agents this session may spawn. */
+export const filterAllowed = <T extends { name: string }>(agents: T[], env: Record<string, string | undefined> = process.env): T[] => {
+  const allowed = allowedAgents(env)
+  return allowed ? agents.filter((a) => allowed.includes(a.name)) : agents
+}
