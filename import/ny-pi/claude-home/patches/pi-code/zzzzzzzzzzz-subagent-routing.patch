@@ -0,0 +1,111 @@
+/**
+ * The saved subagent routing policy (local patch zzzzzzzzzzz-subagent-routing, docs/subagent-routing-2026-11-13.md):
+ * which models, and for each which efforts, spawned subagents may use. Without a file there is no policy and
+ * the harness behaves as before. An invalid file never breaks a spawn: one warning, routing off.
+ */
+import * as fs from 'node:fs'
+import * as os from 'node:os'
+import * as path from 'node:path'
+
+type Env = Record<string, string | undefined>
+
+/** pi's thinking levels in ascending order; the router's ladder is built on this order. */
+export const EFFORTS = ['off', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max'] as const
+export type Effort = (typeof EFFORTS)[number]
+
+export interface RoutingPolicy {
+  version: 1
+  models: Record<string, Effort[]>
+}
+
+const MAX_STRING = 120
+const FORBIDDEN_KEYS = new Set(['__proto__', 'constructor', 'prototype'])
+export const isEffort = (value: unknown): value is Effort => typeof value === 'string' && (EFFORTS as readonly string[]).includes(value)
+export const effortRank = (effort: string): number => (EFFORTS as readonly string[]).indexOf(effort)
+
+export function policyFile(env: Env = process.env): string {
+  const override = env.PI_CODE_SUBAGENT_ROUTING_FILE
+  if (override) return override
+  return path.join(env.PI_CODING_AGENT_DIR || path.join(os.homedir(), '.pi', 'agent'), 'subagent-routing.json')
+}
+
+/** The policy in `raw`, or the reason it is invalid. Efforts come back de-duplicated in ladder order. */
+export function parsePolicy(raw: unknown): RoutingPolicy | string {
+  if (typeof raw !== 'object' || raw === null || Array.isArray(raw)) return 'not a JSON object'
+  const { version, models } = raw as { version?: unknown; models?: unknown }
+  if (version !== 1) return 'version must be 1'
+  if (typeof models !== 'object' || models === null || Array.isArray(models)) return 'models must be an object'
+  const out: Record<string, Effort[]> = {}
+  for (const [key, efforts] of Object.entries(models)) {
+    if (FORBIDDEN_KEYS.has(key)) return `model key ${key} is reserved`
+    if (key.length === 0 || key.length > MAX_STRING) return `model key must be 1-${MAX_STRING} characters`
+    if (!Array.isArray(efforts) || efforts.length === 0) return `model ${key} needs at least one effort`
+    if (!efforts.every((e) => isEffort(e) && e.length <= MAX_STRING)) return `model ${key} has an unknown effort`
+    out[key] = EFFORTS.filter((e) => efforts.includes(e))
+  }
+  if (Object.keys(out).length === 0) return 'models is empty'
+  return { version: 1, models: out }
+}
+
+const warned = new Set<string>()
+const warnOnce = (message: string): void => {
+  if (warned.has(message)) return
+  warned.add(message)
+  console.error(message)
+}
+
+/** Missing file = no policy. Unreadable or invalid = one warning, no policy. */
+export function loadPolicy(env: Env = process.env): RoutingPolicy | undefined {
+  const file = policyFile(env)
+  let text: string
+  try {
+    text = fs.readFileSync(file, 'utf-8')
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') warnOnce(`pi-code-subagent: routing policy ${file} unreadable, routing off: ${(error as Error).message}`)
+    return undefined
+  }
+  let raw: unknown
+  try {
+    raw = JSON.parse(text)
+  } catch {
+    warnOnce(`pi-code-subagent: routing policy ${file} is not valid JSON, routing off`)
+    return undefined
+  }
+  const parsed = parsePolicy(raw)
+  if (typeof parsed === 'string') {
+    warnOnce(`pi-code-subagent: routing policy ${file} invalid (${parsed}), routing off`)
+    return undefined
+  }
+  return parsed
+}
+
+/** Atomic write (tmp + rename), mode 0600. */
+export function savePolicy(policy: RoutingPolicy, env: Env = process.env): void {
+  const file = policyFile(env)
+  fs.mkdirSync(path.dirname(file), { recursive: true })
+  const tmp = `${file}.${process.pid}.tmp`
+  try {
+    fs.writeFileSync(tmp, `${JSON.stringify(policy, null, 2)}\n`, { mode: 0o600 })
+    fs.chmodSync(tmp, 0o600)
+    fs.renameSync(tmp, file)
+  } finally {
+    fs.rmSync(tmp, { force: true })
+  }
+}
+
+/** True when a file was removed, false when there was none (ENOENT); any other failure throws. */
+export function removePolicy(env: Env = process.env): boolean {
+  try {
+    fs.unlinkSync(policyFile(env))
+    return true
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return false
+    throw error
+  }
+}
+
+export function formatPolicy(policy: RoutingPolicy | undefined, env: Env = process.env): string {
+  if (!policy) return `Subagent routing: off (no policy at ${policyFile(env)}).`
+  const rows = Object.entries(policy.models).map(([model, efforts]) => `  ${model}: ${efforts.join(', ')}`)
+  return [`Subagent routing: on (${policyFile(env)})`, ...rows].join('\n')
+}
diff -ruN a/subagent/routing/route.ts b/subagent/routing/route.ts
--- a/subagent/routing/route.ts	1969-12-31 21:00:00.000000000 -0300
+++ b/subagent/routing/route.ts	2026-11-14 01:00:21.137057930 -0300
@@ -0,0 +1,148 @@
+/**
+ * Pure, deterministic spawn router (docs/subagent-routing-2026-11-13.md, AC4). Order: (a) the orchestrator's
+ * request when the policy allows it, (b) otherwise an automatic pick from the agent's tier hint and a small
+ * effort score, (c) a final clamp to the allowlist and to the parent's ceiling (a child never exceeds its
+ * parent's model tier or effort). No I/O and no LLM call: O(models).
+ */
+import { type Effort, effortRank, isEffort, type RoutingPolicy } from './policy.ts'
+
+export interface CatalogModel {
+  /** `provider/id`. */
+  key: string
+  /** Output cost per million tokens; unknown = no tier. */
+  cost?: number
+}
+
+export interface RouteInput {
+  policy: RoutingPolicy
+  catalog: CatalogModel[]
+  /** The parent session's model key and effort; unknown = no ceiling on that axis. */
+  parent: { model?: string; effort?: string }
+  /** Depth of the child being spawned (1 = child of the main session). */
+  degree: number
+  agent: { name: string; tools?: string[]; /** frontmatter model pin or tier alias, a hint only */ pin?: string }
+  brief: string
+  request?: { model?: string; effort?: string }
+}
+
+export interface RouteResult {
+  model: string
+  effort: Effort
+  source: 'orchestrator' | 'auto' | 'clamped'
+  reason: string
+}
+
+const LADDER: readonly Effort[] = ['low', 'medium', 'high', 'xhigh']
+const RISK = /(?<![\p{L}\p{N}_])(auth\w*|autentica\w*|secrets?|secur\w+|migrations?|concurren\w+|race|payments?|money|crypto\w*|deadlocks?|data loss|segurança|segredos?|migração|concorrência|pagamentos?|dinheiro|criptografia|perda de dados)(?![\p{L}\p{N}_])/iu
+const REVIEW_ROLE = /review|secur|plan|advers|audit/i
+const WRITE_TOOLS = new Set(['write', 'edit'])
+
+/** Tier = rank of the model's output cost among the distinct costs of the catalog (ties share a tier). */
+function tierMap(catalog: CatalogModel[]): (key: string | undefined) => number | undefined {
+  const costs = [...new Set(catalog.flatMap((m) => (typeof m.cost === 'number' ? [m.cost] : [])))].sort((a, b) => a - b)
+  const byKey = new Map(catalog.map((m) => [m.key, m.cost]))
+  return (key) => {
+    const cost = key === undefined ? undefined : byKey.get(key)
+    return typeof cost === 'number' ? costs.indexOf(cost) : undefined
+  }
+}
+
+/** Tier of the agent's pin (`provider/id`, bare id or alias such as `sonnet`); the cheapest catalog match. */
+function hintTier(pin: string | undefined, catalog: CatalogModel[], tier: (k: string) => number | undefined): number | undefined {
+  if (!pin) return undefined
+  const needle = pin.toLowerCase()
+  const tiers = catalog.filter((m) => m.key.toLowerCase() === needle || m.key.toLowerCase().includes(needle)).flatMap((m) => tier(m.key) ?? [])
+  return tiers.length ? Math.min(...tiers) : undefined
+}
+
+/** Effort target from the brief, the role and the depth; clamped to low..xhigh (auto never picks off or max). */
+export function autoEffort(input: Pick<RouteInput, 'agent' | 'brief' | 'degree'>): { effort: Effort; notes: string[] } {
+  let score = 1
+  const notes: string[] = []
+  const bump = (delta: number, note: string): void => {
+    score += delta
+    notes.push(`${delta > 0 ? '+' : '-'}${note}`)
+  }
+  if (RISK.test(input.brief)) bump(1, 'risk')
+  if (REVIEW_ROLE.test(input.agent.name)) bump(1, 'review-role')
+  const tools = input.agent.tools
+  if (tools && !tools.some((t) => WRITE_TOOLS.has(t.toLowerCase()))) bump(-1, 'read-only')
+  if (input.brief.length < 400) bump(-1, 'short-brief')
+  else if (input.brief.length > 6000) bump(1, 'long-brief')
+  if (input.degree > 1) bump(-(input.degree - 1), `degree${input.degree}`)
+  return { effort: LADDER[Math.min(LADDER.length - 1, Math.max(0, score))]!, notes }
+}
+
+/** Highest allowed effort <= ceiling, else the lowest allowed one. */
+function clampEffort(allowed: Effort[], target: number, cap: number | undefined): Effort {
+  const ceiling = Math.min(target, cap ?? Infinity)
+  const sorted = [...allowed].sort((a, b) => effortRank(a) - effortRank(b))
+  return [...sorted].reverse().find((e) => effortRank(e) <= ceiling) ?? sorted[0]!
+}
+
+export function hasRisk(brief: string): boolean {
+  return RISK.test(brief)
+}
+
+export function routeSpawn(input: RouteInput): RouteResult | undefined {
+  const { policy, catalog, request } = input
+  const tier = tierMap(catalog)
+  const known = new Set(catalog.map((m) => m.key))
+  // A model the user can no longer run is skipped; an empty catalog (unknown) skips nothing.
+  const allowed = Object.keys(policy.models).filter((key) => known.size === 0 || known.has(key))
+  if (allowed.length === 0) return undefined
+  const reasons: string[] = []
+  const capTier = tier(input.parent.model)
+  const capEffort = isEffort(input.parent.effort) ? effortRank(input.parent.effort) : undefined
+  const byTier = (a: string, b: string): number => (tier(a) ?? Infinity) - (tier(b) ?? Infinity) || a.localeCompare(b)
+  const eligible = allowed.filter((key) => capTier === undefined || (tier(key) ?? Infinity) <= capTier).sort(byTier)
+  const nearest = (target: number | undefined): string => {
+    if (target === undefined) return eligible[0]!
+    return [...eligible].sort((a, b) => Math.abs((tier(a) ?? Infinity) - target) - Math.abs((tier(b) ?? Infinity) - target) || byTier(a, b))[0]!
+  }
+  let clamped = false
+  let unsatisfiable = false
+  let model: string
+  if (eligible.length === 0) {
+    // Nothing allowed fits under the parent's tier: the cheapest allowed model at its lowest effort.
+    model = [...allowed].sort(byTier)[0]!
+    unsatisfiable = true
+    clamped = true
+    reasons.push('no allowed model within the parent ceiling: cheapest allowed')
+  } else if (request?.model) {
+    if (eligible.includes(request.model)) model = request.model
+    else {
+      clamped = true
+      model = nearest(tier(request.model))
+      reasons.push(allowed.includes(request.model) ? `${request.model} above the parent ceiling` : `${request.model} not allowed`)
+    }
+  } else {
+    const base = hintTier(input.agent.pin, catalog, (k) => tier(k)) ?? capTier
+    model = nearest(base)
+    if (hasRisk(input.brief)) {
+      const up = eligible.find((key) => (tier(key) ?? -1) > (tier(model) ?? Infinity))
+      if (up) model = up
+    }
+  }
+  const supported = policy.models[model]!
+  let effort: Effort
+  if (unsatisfiable) effort = clampEffort(supported, -1, undefined)
+  else if (request?.effort && isEffort(request.effort)) {
+    effort = clampEffort(supported, effortRank(request.effort), capEffort)
+    if (effort !== request.effort) {
+      clamped = true
+      reasons.push(`effort ${request.effort} -> ${effort}`)
+    }
+  } else {
+    const auto = autoEffort(input)
+    effort = clampEffort(supported, effortRank(auto.effort), capEffort)
+    if (effort !== auto.effort) reasons.push(`effort ${auto.effort} -> ${effort}`)
+    reasons.unshift(`score ${auto.effort}${auto.notes.length ? ` (${auto.notes.join(' ')})` : ''}`)
+  }
+  if (capEffort !== undefined && effortRank(effort) > capEffort) {
+    clamped = true
+    reasons.push('no allowed effort within the parent ceiling: lowest allowed')
+  }
+  const source = clamped ? 'clamped' : request?.model || (request?.effort && isEffort(request.effort)) ? 'orchestrator' : 'auto'
+  return { model, effort, source, reason: reasons.join('; ') || 'as requested' }
+}
diff -ruN a/subagent/routing/setup-ui.ts b/subagent/routing/setup-ui.ts
--- a/subagent/routing/setup-ui.ts	1969-12-31 21:00:00.000000000 -0300
+++ b/subagent/routing/setup-ui.ts	2026-11-14 01:00:21.137083570 -0300
@@ -0,0 +1,111 @@
+/**
+ * The /subagents-setup modal (docs/subagent-routing-2026-11-13.md, AC1): step 1 marks the models subagents may
+ * use, step 2 marks, per marked model, the efforts allowed. up/down move, space toggles, enter confirms the
+ * step, esc cancels without saving. Pure state + render so it is testable without a TUI.
+ */
+import { isKeyRelease, matchesKey, truncateToWidth } from '@earendil-works/pi-tui'
+import type { Component } from '@earendil-works/pi-tui'
+import { type Effort, EFFORTS, type RoutingPolicy } from './policy.ts'
+
+export interface SetupModel {
+  key: string
+  /** Efforts this model supports, ascending. */
+  levels: Effort[]
+}
+
+export interface SetupOptions {
+  models: SetupModel[]
+  current: RoutingPolicy | undefined
+  /** The new policy on enter at the last step, undefined on esc. */
+  done: (policy: RoutingPolicy | undefined) => void
+  requestRender?: () => void
+}
+
+/** What a model not in the current policy starts with: the everyday levels, else everything it supports. */
+const DEFAULT_LEVELS: readonly Effort[] = ['low', 'medium', 'high']
+
+export class SetupComponent implements Component {
+  private step: 'models' | 'efforts' = 'models'
+  private cursor = 0
+  private error = ''
+  private readonly marked: Set<string>
+  private readonly efforts = new Map<string, Set<Effort>>()
+  private queue: SetupModel[] = []
+  private page = 0
+
+  private readonly opts: SetupOptions
+
+  constructor(opts: SetupOptions) {
+    this.opts = opts
+    this.marked = new Set(opts.models.filter((m) => opts.current?.models[m.key]).map((m) => m.key))
+  }
+
+  private get items(): string[] {
+    return this.step === 'models' ? this.opts.models.map((m) => m.key) : (this.queue[this.page]?.levels ?? [])
+  }
+
+  private isOn(item: string): boolean {
+    return this.step === 'models' ? this.marked.has(item) : (this.efforts.get(this.queue[this.page]!.key)?.has(item as Effort) ?? false)
+  }
+
+  private toggle(): void {
+    const item = this.items[this.cursor]
+    if (item === undefined) return
+    this.error = ''
+    const set = this.step === 'models' ? this.marked : this.efforts.get(this.queue[this.page]!.key)!
+    if (set.has(item as Effort)) set.delete(item as Effort)
+    else set.add(item as Effort)
+  }
+
+  private enter(): void {
+    if (this.step === 'models') {
+      this.queue = this.opts.models.filter((m) => this.marked.has(m.key))
+      if (this.queue.length === 0) {
+        this.error = 'Mark at least one model.'
+        return
+      }
+      for (const m of this.queue) {
+        if (this.efforts.has(m.key)) continue
+        const own = this.opts.current?.models[m.key]?.filter((e) => m.levels.includes(e))
+        const fallback = m.levels.filter((e) => DEFAULT_LEVELS.includes(e))
+        this.efforts.set(m.key, new Set(own?.length ? own : fallback.length ? fallback : m.levels))
+      }
+      this.step = 'efforts'
+      this.page = 0
+      this.cursor = 0
+      return
+    }
+    if (this.efforts.get(this.queue[this.page]!.key)!.size === 0) {
+      this.error = 'Mark at least one effort.'
+      return
+    }
+    if (this.page + 1 < this.queue.length) {
+      this.page++
+      this.cursor = 0
+      return
+    }
+    const models: Record<string, Effort[]> = {}
+    for (const m of this.queue) models[m.key] = EFFORTS.filter((e) => this.efforts.get(m.key)!.has(e))
+    this.opts.done({ version: 1, models })
+  }
+
+  handleInput(data: string): void {
+    if (isKeyRelease(data)) return
+    if (matchesKey(data, 'escape')) return this.opts.done(undefined)
+    if (matchesKey(data, 'up')) this.cursor = Math.max(0, this.cursor - 1)
+    else if (matchesKey(data, 'down')) this.cursor = Math.min(this.items.length - 1, this.cursor + 1)
+    else if (matchesKey(data, 'space')) this.toggle()
+    else if (matchesKey(data, 'enter')) this.enter()
+    else return
+    this.opts.requestRender?.()
+  }
+
+  render(width: number): string[] {
+    const title = this.step === 'models' ? 'Subagent models: which may subagents use?' : `Efforts for ${this.queue[this.page]!.key} (${this.page + 1}/${this.queue.length})`
+    const rows = this.items.map((item, i) => `${i === this.cursor ? '>' : ' '} [${this.isOn(item) ? 'x' : ' '}] ${item}`)
+    const lines = [title, '', ...rows, '', this.error || 'up/down move · space toggle · enter next/save · esc cancel']
+    return lines.map((line) => truncateToWidth(line, width))
+  }
+
+  invalidate(): void {}
+}
diff -ruN a/subagent/routing/text.ts b/subagent/routing/text.ts
--- a/subagent/routing/text.ts	1969-12-31 21:00:00.000000000 -0300
+++ b/subagent/routing/text.ts	2026-11-14 01:00:21.137075210 -0300
@@ -0,0 +1,15 @@
+/** Tool-description text for the saved routing policy: the allowlist and short scaling rules (<= 600 chars). */
+import type { RoutingPolicy } from './policy.ts'
+
+export const ROUTING_NOTE_MAX = 600
+
+const RULES = 'Omit model/effort and the router picks; a child never exceeds its parent model tier or effort. Effort: low for lookups and read-only mapping, medium for specified edits, high for security, concurrency, migrations and reviews. tools/skills only narrow the agent\'s own.'
+
+export function routingDescription(policy: RoutingPolicy): string {
+  const head = 'Allowed model[efforts]: '
+  const budget = ROUTING_NOTE_MAX - head.length - RULES.length - 2
+  const items = Object.entries(policy.models).map(([model, efforts]) => `${model}[${efforts.join(',')}]`)
+  let list = items.join(' ')
+  if (list.length > budget) list = `${list.slice(0, Math.max(0, budget - 1))}…`
+  return `${head}${list}. ${RULES}`
+}
