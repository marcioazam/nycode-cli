+/** Claude's `onFailure: "block"`: an exit other than 0 and 2 (2 is the hook's own block) fails the
+ * call closed. Timeout and spawn failure are handled by the callers. */
+function onFailureBlock(command: HookCommand, result: HookRunResult): string | undefined {
+  if (command.onFailure !== 'block' || result.timedOut || result.spawnFailed || result.code === 0 || result.code === 2) return undefined
+  const firstLine = result.stderr.trim().split('\n')[0]
+  return `Hook failed (exit ${result.code}, onFailure: block): ${command.command}${firstLine ? `: ${firstLine}` : ''}`
+}
