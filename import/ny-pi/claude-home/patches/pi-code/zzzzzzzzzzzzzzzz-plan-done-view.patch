+// Exibição das tags [DONE:n] no chat (pedido do dono, 2026-11-14): só o texto mostrado muda; a sessão, o modelo e o rastreador seguem com a tag literal.
+// Puro, sem pi: texto + etapas do plano -> texto exibido. Código (``` e `inline`) fica literal.
+export interface DoneStep {
+  step: number
+  text: string
+}
+export interface DonePaint {
+  ok: (s: string) => string
+  muted: (s: string) => string
+  text: (s: string) => string
+}
+
+export const plainPaint: DonePaint = { ok: (s) => s, muted: (s) => s, text: (s) => s }
+
+const TAG = /\[DONE:(\d+)\]/gi
+const ONLY_TAGS = /^\s*(?:\[DONE:\d+\]\s*)+$/i
+const FENCE = /^\s*(```|~~~)/
+// Prefixo incompleto de tag no fim do texto em streaming: some até a tag fechar, em vez de piscar cru.
+const PARTIAL = /\[(?:D(?:O(?:N(?:E(?::\d*)?)?)?)?)?$/i
+
+export function renderDoneTags(text: string, steps: readonly DoneStep[] | undefined, paint: DonePaint = plainPaint, streaming = false): string {
+  if (!text.includes('[')) return text
+  const titles = new Map((steps ?? []).map((s) => [s.step, s.text]))
+  const total = steps && steps.length > 0 ? Math.max(...steps.map((s) => s.step), steps.length) : 0
+  const ok = paint.ok('✓')
+  const one = (n: number, block: boolean): string => {
+    const title = titles.get(n)
+    if (block && title !== undefined) return `${ok} ${paint.muted(`etapa ${n}/${total}`)} ${paint.muted('·')} ${paint.text(title)}`
+    return `${ok} ${paint.muted(block ? `etapa ${n} concluída` : `etapa ${n}`)}`
+  }
+  let fenced = false
+  const lines = text.split('\n').map((line) => {
+    if (FENCE.test(line)) {
+      fenced = !fenced
+      return line
+    }
+    if (fenced || !line.includes('[')) return line
+    if (ONLY_TAGS.test(line)) return [...line.matchAll(TAG)].map((m) => one(Number(m[1]), true)).join('\n')
+    // Pares de crases primeiro: o que está entre eles não é tocado.
+    return line
+      .split(/(`[^`]*`)/)
+      .map((part, i) => (i % 2 === 1 ? part : part.replace(TAG, (_m, n) => one(Number(n), false))))
+      .join('')
+  })
+  let out = lines.join('\n')
+  if (streaming && !fenced) out = out.replace(PARTIAL, '')
+  return out
+}
