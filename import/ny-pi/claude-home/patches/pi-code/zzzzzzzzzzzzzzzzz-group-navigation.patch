--- a/subagent/section-nav/nav.ts
+++ b/subagent/section-nav/nav.ts
@@ -0,0 +1,124 @@
+/**
+ * Two-level keyboard navigation of the groups under the editor (RUN, TODO/PLAN, Sub Agents, Status Line).
+ * Level 1: ↓ on an empty editor focuses the TITLE of the first group in real visual order; ↑↓ then walk the titles only;
+ * ↑ on the first title (or Esc) gives the keyboard back to the editor. Level 2: Enter on a title gives the body the
+ * keyboard (each group keeps its own item keys); Esc in the body returns to the same title. A group without items
+ * (Status Line) has no body: Enter and Space fold it. The editor keeps native focus while a title is focused.
+ * Visual order is not fixed (pi moves a re-set widget last), so every group stamps its render and the order is the
+ * last render pass. Record: docs/pi-group-navigation-2026-11-14.md.
+ */
+import { isKeyRelease, matchesKey } from '@earendil-works/pi-tui'
+
+export type GroupId = 'run' | 'plan' | 'subagents' | 'status'
+
+export interface NavGroup {
+  id: GroupId
+  /** The group shows now (a hidden or empty group is skipped and never keeps the focus). */
+  active(): boolean
+  /** Items to navigate; false = informational group. */
+  hasBody: boolean
+  folded(): boolean
+  toggle(): void
+  /** Give the body the keyboard; false when it cannot take it. */
+  enter(): boolean
+}
+
+/** Fallback order for a group not yet rendered. */
+const DEFAULT_ORDER: GroupId[] = ['run', 'plan', 'subagents', 'status']
+
+export class GroupNav {
+  private readonly groups = new Map<GroupId, NavGroup>()
+  private readonly stamps = new Map<GroupId, number>()
+  private pass = new Set<GroupId>()
+  private seq = 0
+  /** Group whose title holds the focus. */
+  title: GroupId | undefined
+
+  register(group: NavGroup): void {
+    this.groups.set(group.id, group)
+  }
+
+  unregister(id: GroupId): void {
+    this.groups.delete(id)
+    this.stamps.delete(id)
+    this.pass.delete(id)
+    if (this.title === id) this.title = undefined
+  }
+
+  /** Called first in every group render: the order of the last render pass is the visual order. */
+  stamp(id: GroupId): void {
+    if (this.pass.has(id)) this.pass = new Set()
+    this.pass.add(id)
+    this.stamps.set(id, ++this.seq)
+  }
+
+  /** Active groups, top to bottom. */
+  order(): GroupId[] {
+    const active = [...this.groups.values()].filter((g) => g.active()).map((g) => g.id)
+    const seen = active.filter((id) => this.pass.has(id)).sort((a, b) => this.stamps.get(a)! - this.stamps.get(b)!)
+    return [...seen, ...DEFAULT_ORDER.filter((id) => active.includes(id) && !this.pass.has(id))]
+  }
+
+  /** The title of `id` is the focused one (a group that went away never is). */
+  isTitle(id: GroupId): boolean {
+    return this.title === id && this.groups.get(id)?.active() === true
+  }
+
+  /** Esc (or a lost body) returns to the title of `id`. */
+  back(id: GroupId): void {
+    if (this.groups.get(id)?.active()) this.title = id
+  }
+
+  /** ↓ on an empty editor: the first title. False when no group shows. */
+  focusFirst(): boolean {
+    const first = this.order()[0]
+    this.title = first
+    return first !== undefined
+  }
+
+  /** Keys while a title is focused (or the entry ↓ from the editor); true = consumed. */
+  handleKey(data: string, env: { editorText: string; editorFocused: boolean; overlayOpen: boolean }): boolean {
+    if (isKeyRelease(data)) return false
+    if (!env.editorFocused || env.overlayOpen) {
+      this.title = undefined
+      return false
+    }
+    if (this.title === undefined || !this.isTitle(this.title)) {
+      this.title = undefined
+      // Real bottom limit of a multi-line editor is not exposed by pi's editor: only an empty one hands ↓ over.
+      return matchesKey(data, 'down') && env.editorText === '' && this.focusFirst()
+    }
+    const group = this.groups.get(this.title)!
+    const order = this.order()
+    const at = order.indexOf(group.id)
+    if (matchesKey(data, 'down')) {
+      this.title = order[Math.min(order.length - 1, at + 1)]
+      return true
+    }
+    if (matchesKey(data, 'up')) {
+      this.title = at > 0 ? order[at - 1] : undefined
+      return true
+    }
+    if (matchesKey(data, 'escape')) {
+      this.title = undefined
+      return true
+    }
+    if (matchesKey(data, 'enter')) {
+      if (!group.hasBody) group.toggle()
+      else {
+        if (group.folded()) group.toggle()
+        this.title = undefined
+        if (!group.enter()) this.title = group.id
+      }
+      return true
+    }
+    if (matchesKey(data, 'space') || (matchesKey(data, 'left') && !group.folded()) || (matchesKey(data, 'right') && group.folded())) {
+      group.toggle()
+      return true
+    }
+    this.title = undefined
+    return false
+  }
+}
+
+export const nav = new GroupNav()
