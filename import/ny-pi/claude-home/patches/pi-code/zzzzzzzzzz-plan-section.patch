+/**
+ * Shared mechanics of the two collapsible sections under the editor (Sub Agents, Status Line and Plan): viewport size,
+ * offset clamp, focus ownership test and the bridge the status line and the fleet panel use to reach the Plan
+ * section. Pure apart from the `bridge` singleton, which the Plan section fills in. Record:
+ * docs/pi-interactive-display-2026-11-13.md ("Plan section").
+ */
+import { isKeyRelease, matchesKey } from '@earendil-works/pi-tui'
+
+/** Plan body rows: at most 6, at least 3, fewer on short terminals. Never unbounded. */
+export const MAX_VISIBLE = 6
+export const MIN_VISIBLE = 3
+export const viewportSize = (terminalRows: number): number => Math.max(MIN_VISIBLE, Math.min(MAX_VISIBLE, terminalRows - 18))
+
+/** Offset kept inside [0, total - visible]. */
+export const clampOffset = (offset: number, total: number, visible: number): number => Math.max(0, Math.min(offset, Math.max(0, total - visible)))
+
+/** pi's TUI keeps the focused component private: the editor (getText + setText) owns it; unknown counts as the editor. */
+export function editorOwnsFocus(tui: unknown): boolean {
+  const focused = (tui as { focusedComponent?: unknown } | undefined)?.focusedComponent
+  if (focused == null) return true
+  const c = focused as { getText?: unknown; setText?: unknown }
+  return typeof c.getText === 'function' && typeof c.setText === 'function'
+}
+
+/** Links between the Plan section (plan-mode), the status line and the fleet panel; one process, one section each. */
+export interface SectionBridge {
+  /** A Plan section is showing (items exist). The status line then keeps its row in the widget, above Plan. */
+  planActive(): boolean
+  /** Re-set the Plan widget so it renders after the status widget (pi moves a re-set widget last). */
+  reassertPlan(): void
+  /** Plan appeared, changed visibility or went away: the status line re-places its footer-only row. */
+  onPlanChange?: () => void
+  /** Plan holds the keyboard (keyboard path): the fleet panel must not take ↓ meanwhile. */
+  planFocused(): boolean
+  /** ↓ from the Sub Agents list: give the keyboard to Plan. False when Plan is not showing. */
+  focusPlan(): boolean
+  /** ↑ from the top of Plan: back to the last Sub Agents row. False when there is no list. */
+  focusFleetLast?: () => boolean
+  /** The Status Line widget shows (it can fold and take the keyboard). */
+  statusActive(): boolean
+  /** The Status Line holds the keyboard (virtual focus, the editor keeps native focus). */
+  statusFocused(): boolean
+  /** ↓ from the last Sub Agents row, ↑ from the top of Plan: give the keyboard to the Status Line. False when it is not showing. */
+  focusStatus(): boolean
+  /** Sub Agents has child rows: the Status Line and Plan then leave the empty-editor ↓ entry to it. */
+  fleetActive(): boolean
+}
+export const bridge: SectionBridge = {
+  planActive: () => false,
+  reassertPlan: () => {},
+  focusPlan: () => false,
+  planFocused: () => false,
+  statusActive: () => false,
+  statusFocused: () => false,
+  focusStatus: () => false,
+  fleetActive: () => false,
+}
+
+/** Fold + keyboard focus of the Status Line widget, kept in memory for the session (a re-set widget keeps it).
+ * Chain from an empty editor: Sub Agents → Status Line → Plan (each only when it shows), ↑ the way back, Esc the editor. */
+export class StatusFold {
+  collapsed = false
+  focused = false
+  private readonly deps: { active(): boolean; render(): void }
+
+  constructor(deps: { active(): boolean; render(): void }) {
+    this.deps = deps
+  }
+
+  reset(): void {
+    this.collapsed = false
+    this.focused = false
+  }
+
+  toggle(): void {
+    this.collapsed = !this.collapsed
+    this.deps.render()
+  }
+
+  focusByKeyboard(): boolean {
+    if (!this.deps.active()) return false
+    this.focused = true
+    this.deps.render()
+    return true
+  }
+
+  /** True when the key was used (consume). */
+  handleKey(data: string, env: { editorText: string; editorFocused: boolean }): boolean {
+    if (isKeyRelease(data)) return false
+    if (!env.editorFocused || !this.deps.active()) {
+      this.focused = false
+      return false
+    }
+    if (!this.focused) {
+      // A draft keeps ↓ for the editor; Sub Agents (when it has rows) and a focused Plan own the entry.
+      if (!matchesKey(data, 'down') || env.editorText !== '' || bridge.fleetActive() || bridge.planFocused()) return false
+      return this.focusByKeyboard()
+    }
+    const used = (): true => (this.deps.render(), true)
+    if (matchesKey(data, 'down')) {
+      if (bridge.focusPlan()) this.focused = false
+      return used()
+    }
+    if (matchesKey(data, 'up')) {
+      this.focused = false
+      if (bridge.fleetActive()) bridge.focusFleetLast?.()
+      return used()
+    }
+    if (matchesKey(data, 'escape')) {
+      this.focused = false
+      return used()
+    }
+    if (matchesKey(data, 'space') || (matchesKey(data, 'left') && !this.collapsed) || (matchesKey(data, 'right') && this.collapsed)) {
+      this.collapsed = !this.collapsed
+      return used()
+    }
+    this.focused = false
+    this.deps.render()
+    return false
+  }
+}
