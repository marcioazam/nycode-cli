/target
**/*.rs.bk
*.pdb

# Artefatos de cobertura e benchmark
/coverage
lcov.info
cov.lcov
coverage.json
coverage-baseline.json
/bench-results

# Saida do cargo-mutants (GATE-04). Gravada no cwd a cada execucao de
# scripts/mutation-gate.sh ou scripts/mutation-gate-test.sh; nunca versionada.
mutants.out/
mutants.out.old/

# Artefatos que o proprio nycode grava ao rodar. Hooks, skills e regras em
# `.nycode/` sao versionaveis; sessao e cache de catalogo nao. O `**` e
# obrigatorio: um padrao com barra no meio fica ancorado na raiz do repositorio
# e nao alcancaria as raizes de teste sob `crates/`, que e onde a suite grava.
**/.nycode/sessions/
**/.nycode/catalog.json

# Ambiente local
.env
.env.*
!.env.example

# Estado de sessão do próprio nycode, gravado na raiz do workspace: transcritos,
# catálogo de modelos em cache. O transcrito carrega todo prompt e o conteúdo de
# todo arquivo lido no turno, e um `git add -A` o levaria junto.
.nycode/

# Estado local de ferramenta de agente, por maquina.
.omc/
.claude/settings.local.json

# Editores
.idea/
*.swp
.DS_Store
