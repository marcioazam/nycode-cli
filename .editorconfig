root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Same as biome.json (indentStyle tab, indentWidth 3)
[*.{ts,tsx,js,mjs,cjs,json,jsonc}]
indent_style = tab
indent_size = 3
tab_width = 3

[package-lock.json]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false
