#!/usr/bin/env bash
# nycode-typecheck — roda `tsc --noEmit` nas extensões de ~/.nycode/agent/extensions contra os tipos do checkout.
#
# Por que um script e não um tsconfig fixo: o caminho dos .d.ts depende do checkout (NYCODE_REPO, padrão: a raiz
# deste repositório), então o tsconfig é gerado em /tmp. Os tipos vêm de `npm run build` (dist/*.d.ts).
# Hoje o LSP do harness não sobe aqui ("Could not find a valid TypeScript installation"), e o erro de tipo numa
# extensão só aparece em runtime, com a sessão já quebrada.
#
# Testes ficam de fora: usam stubs propositalmente parciais do ExtensionAPI.
# Uso: nycode-typecheck [dir]   (padrão: ~/.nycode/agent/extensions). Somente leitura; sai 1 se o tsc reclamar.
# Origem: auditoria 2026-11-13 de configs públicas.
set -euo pipefail

AGENT="${NYCODE_CODING_AGENT_DIR:-$HOME/.nycode/agent}"
DIR="$(realpath "${1:-$AGENT/extensions}")"
REPO="${NYCODE_REPO:-$(cd "$(dirname "$0")/../../.." && pwd)}"
MODULES="$REPO/node_modules"
[ -f "$REPO/packages/coding-agent/dist/index.d.ts" ] || {
  echo "nycode-typecheck: tipos não encontrados em $REPO/packages/coding-agent/dist (rode npm run build)" >&2
  exit 1
}
command -v tsc >/dev/null || {
  echo "nycode-typecheck: tsc não está no PATH" >&2
  exit 1
}

tmpdir="$(mktemp -d)"
trap 'rm -r "$tmpdir"' EXIT
cfg="$tmpdir/tsconfig.json"
cat >"$cfg" <<EOF
{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "strict": true,
    "strictPropertyInitialization": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@nycode/coding-agent": ["$REPO/packages/coding-agent/dist/index.d.ts"],
      "@nycode/*": ["$REPO/packages/*/dist/index.d.ts"],
      "typebox": ["$MODULES/typebox/build/index.d.mts"]
    },
    "typeRoots": ["$MODULES/@types"],
    "types": ["node"]
  },
  "include": ["$DIR/**/*.ts"],
  "exclude": ["$DIR/**/*.test.ts", "$DIR/**/test/**"]
}
EOF
tsc -p "$cfg"
