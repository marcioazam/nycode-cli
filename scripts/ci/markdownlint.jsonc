{
  // Permissive on purpose: long lines, tables and inline HTML are normal in these docs.
  "config": {
    "default": true,
    "MD013": false,
    "MD024": false,
    "MD032": false,
    "MD033": false,
    "MD036": false,
    "MD041": false,
    "MD060": false
  },
  // Upstream changelogs keep upstream formatting (rewriting them would conflict on every sync, 08); nycode entries
  // go under [Unreleased] as AGENTS.md says.
  "ignores": ["packages/*/CHANGELOG.md"],
  "gitignore": false,
  "noProgress": true
}
