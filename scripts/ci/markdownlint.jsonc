{
  // Permissive on purpose: long lines, tables and inline HTML are normal in these docs.
  "config": {
    "default": true,
    "MD013": false,
    "MD024": false,
    "MD032": false,
    "MD033": false,
    "MD036": false,
    "MD041": false,
    "MD060": false
  },
  // Upstream changelogs keep upstream formatting (rewriting them would conflict on every sync, 08); nycode entries
  // go under [Unreleased] as AGENTS.md says.
  // docs/migration/ny-pi-arquivo/: verbatim ny-pi archive, not maintained (owner decision 2026-11-21). Only its
  // README.md is linted: the second glob skips the top-level files that do not start with R.
  "ignores": ["packages/*/CHANGELOG.md", "docs/migration/ny-pi-arquivo/*/**", "docs/migration/ny-pi-arquivo/[^R]*.md"],
  "gitignore": false,
  "noProgress": true
}
